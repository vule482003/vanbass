APP_NAME=VanBass Music Center API
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://vanbass:change_me@localhost:5432/vanbass
REDIS_URL=redis://localhost:6379/0

DEBUG=true

JWT_SECRET_KEY=your-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# VNPAY Payment Gateway
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Khi test local: dung ngrok (ngrok http 8000) roi thay URL duoi day
VNPAY_IPN_URL=https://your-domain.com/api/orders/vnpay/ipn
VNPAY_RETURN_URL=https://your-domain.com/payment/result

# ==========================================
# Cấu hình Gửi Email (Gmail SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vanbass.music@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=vanbass.music@gmail.com
SMTP_FROM_NAME=VanBass Music Center
# Danh sách email nhận thông báo đơn hàng mới của Shop & Nhân viên (phân cách bằng dấu phẩy)
SHOP_NOTIFY_EMAILS=admin@vanbass.vn,staff@vanbass.vn